generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id           String   @id @default(uuid())
  name         String?
  lastname     String?
  gender       String?
  phone_number String?  @map("phone_number")
  email        String?  @unique
  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @updatedAt @map("updated_at")

  // Auth Relation fields
  created_by String @map("created_by")
  creator    User   @relation(fields: [created_by], references: [id], onDelete: Cascade)

  contracts Contract[]
  sales     Sales[]

  @@map("clients")
}

enum ContractStatus {
  not_paid              @map("not-paid")
  only_advanced_payment @map("only-advanced-payment")
  pending
  paid
}

model Contract {
  id               String         @id @default(uuid())
  name             String
  type             String
  amount           Decimal        @db.Decimal(10, 2)
  status           ContractStatus @default(not_paid)
  remaining_amount Decimal        @map("remaining_amount") @db.Decimal(10, 2)
  created_at       DateTime       @default(now()) @map("created_at")
  updated_at       DateTime       @updatedAt @map("updated_at")

  client_id String @map("client_id")
  client    Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  // Auth Relation fields
  created_by String @map("created_by")
  creator    User   @relation(fields: [created_by], references: [id], onDelete: Cascade)

  clientLogs ClientLog[]

  @@map("contracts")
}

model ClientLog {
  id              String         @id @default(uuid())
  name            String?
  lastname        String?
  phone           String?
  contract_id     String         @map("contract_id")
  contract_name   String         @map("contract_name")
  payment_type    String         @map("payment_type")
  amount          Decimal        @db.Decimal(10, 2)
  contract_status ContractStatus @map("contract_status")
  created_at      DateTime       @default(now()) @map("created_at")
  updated_at      DateTime       @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contract_id], references: [id], onDelete: Cascade)

  // Auth Relation fields
  created_by String @map("created_by")
  creator    User   @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@map("client_logs")
}

model Sales {
  id              String   @id @default(uuid())
  client_id       String   @map("client_id")
  client_name     String   @map("client_name")
  client_lastname String   @map("client_lastname")
  project_id      String?  @map("project_id")
  property_id     String?  @unique @map("property_id") // @unique asegura la relación 1:1 (-)
  concept         String
  amount          Decimal  @db.Decimal(10, 2)
  date            DateTime
  is_credit       Boolean  @map("is_credit")
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  // Auth Relation fields
  created_by String @map("created_by")
  creator    User   @relation(fields: [created_by], references: [id], onDelete: Cascade)

  client   Client              @relation(fields: [client_id], references: [id])
  project  Project?            @relation(fields: [project_id], references: [id])
  property ProjectsProperties? @relation(fields: [property_id], references: [id])

  @@map("sales")
}

model Labor {
  id                     String   @id @default(uuid())
  worker_name            String   @map("worker_name")
  worker_lastname        String   @map("worker_lastname")
  phone                  String
  has_insurance          Boolean  @map("has_insurance")
  social_security_number String?  @map("social_security_number")
  job                    String?
  working_since          DateTime @map("working_since")
  created_at             DateTime @default(now()) @map("created_at")
  updated_at             DateTime @updatedAt @map("updated_at")

  // Auth Relation fields
  created_by String @map("created_by")
  creator    User   @relation(fields: [created_by], references: [id], onDelete: Cascade)

  laborRecords Expenses[]

  @@map("labor")
}

model Expenses {
  id              String   @id @default(uuid())
  worker_id       String?  @map("worker_id")
  worker_name     String?  @map("worker_name")
  worker_lastname String?  @map("worker_lastname")
  phone_number    String?  @map("phone_number")
  payroll         Boolean?
  amount          Decimal  @db.Decimal(10, 2)
  date            DateTime
  project_id      String?  @map("project_id")
  property_id     String?  @map("property_id")
  concept         String
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")

  // Auth Relation fields
  created_by String @map("created_by")
  creator    User   @relation(fields: [created_by], references: [id], onDelete: Cascade)

  worker   Labor?              @relation(fields: [worker_id], references: [id])
  project  Project?            @relation(fields: [project_id], references: [id])
  property ProjectsProperties? @relation(fields: [property_id], references: [id])

  @@map("expenses")
}

model Project {
  id                   String    @id @default(uuid())
  project_name         String    @map("project_name")
  owners_or_associates Json?     @map("owners_or_associates")
  lots                 Int
  start_date           DateTime  @map("start_date")
  end_date             DateTime? @map("end_date")
  address              Json
  created_at           DateTime  @default(now()) @map("created_at")
  updated_at           DateTime  @updatedAt @map("updated_at")

  // Auth Relation fields
  created_by String @map("created_by")
  creator    User   @relation(fields: [created_by], references: [id], onDelete: Cascade)

  properties  ProjectsProperties[]
  hhrrRecords Expenses[]
  reports     Report[]
  sales       Sales[]

  @@map("projects")
}

model ProjectsProperties {
  id               String    @id @default(uuid())
  project_id       String?   @map("project_id")
  property_name    String    @map("property_name")
  number_of_lots   Int       @map("number_of_lots")
  estimated_budget Decimal   @map("estimated_budget") @db.Decimal(10, 2)
  start_date       DateTime  @map("start_date")
  end_date         DateTime? @map("end_date")
  created_at       DateTime  @default(now()) @map("created_at")
  updated_at       DateTime  @updatedAt @map("updated_at")

  // Auth Relation fields
  created_by String @map("created_by")
  creator    User   @relation(fields: [created_by], references: [id], onDelete: Cascade)

  project Project?   @relation(fields: [project_id], references: [id])
  sales   Sales?
  hhrr    Expenses[]
  reports Report[]

  @@map("projects_properties")
}

model Report {
  id          String   @id @default(uuid())
  name        String
  model       String
  query       Json
  date        DateTime
  is_bill     Boolean  @map("is_bill")
  issued_by   String   @map("issued_by")
  project_id  String   @map("project_id")
  property_id String?  @map("property_id")
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  // Auth Relation fields
  created_by String @map("created_by")
  creator    User   @relation(fields: [created_by], references: [id], onDelete: Cascade)

  project  Project             @relation(fields: [project_id], references: [id])
  property ProjectsProperties? @relation(fields: [property_id], references: [id])

  @@map("reports")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Back-relations for data ownership isolation
  clients            Client[]
  contracts          Contract[]
  clientLogs         ClientLog[]
  sales              Sales[]
  hhrrWorkers        Labor[]
  hhrrRecords        Expenses[]
  projects           Project[]
  projectsProperties ProjectsProperties[]
  reports            Report[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
